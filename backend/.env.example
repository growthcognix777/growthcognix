DATABASE_URL=postgresql+psycopg://growth:growth@db:5432/growthcognix
REDIS_URL=redis://redis:6379/0
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=480
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=20

# ---- Phase 2: AI providers (free tiers). Keys stay on the server, never in the frontend. ----
# Gemini key: https://aistudio.google.com/apikey   Groq key: https://console.groq.com/keys
AI_ANALYSIS_PROVIDER=gemini
AI_FAST_PROVIDER=groq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_TIMEOUT_SECONDS=90
ANALYSIS_INLINE=false
WEBSITE_MAX_PAGES=5

# ---- Phase 3: website audit & competitor intelligence ----
# native = built-in robots.txt-aware crawler (free). firecrawl = self-hosted Firecrawl (free, AGPL) or Firecrawl cloud (paid beyond its free credits)
CRAWLER_PROVIDER=native
FIRECRAWL_API_URL=
FIRECRAWL_API_KEY=
CRAWL_MAX_PAGES_LIMIT=500
CRAWL_DEFAULT_MAX_PAGES=50
CRAWL_DEFAULT_MAX_DEPTH=3
CRAWL_DEFAULT_DELAY_SECONDS=1.0
CRAWL_TIMEOUT_SECONDS=20
CRAWL_MAX_BYTES=3000000
COMPETITOR_MAX_PAGES=25
# Google PageSpeed Insights API key (free, from Google Cloud console). Empty = performance not measured.
PAGESPEED_API_KEY=

# ---- Phase 4: buyer discovery (all optional; unconfigured sources are skipped, never simulated) ----
# Self-hosted SearXNG with the JSON format enabled (free), e.g. http://searxng:8080
SEARXNG_URL=
# Google Programmable Search: about 100 free queries/day
GOOGLE_PSE_KEY=
GOOGLE_PSE_CX=
# Brave Search API: metered ($5 per 1,000 requests, $5 monthly credit, card required)
BRAVE_API_KEY=
# UN Comtrade subscription key (optional; the public preview needs none)
COMTRADE_API_KEY=
DISCOVERY_DAILY_LIMIT_SEARXNG=500
DISCOVERY_DAILY_LIMIT_GOOGLE_PSE=100
DISCOVERY_DAILY_LIMIT_BRAVE=30
DISCOVERY_DAILY_LIMIT_DIRECTORY=50
DISCOVERY_MAX_COMPANIES=200
DISCOVERY_VERIFY_PAGES=3

# ---- Phase 5: marketing (all optional; unconfigured channels show as not configured, never simulated) ----
# Fernet key that encrypts OAuth tokens. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MARKETING_TOKEN_KEY=
# Where Meta/LinkedIn redirect after sign-in (must match the app settings) and where the browser returns
PUBLIC_API_URL=http://localhost:8000
PUBLIC_APP_URL=http://localhost:3000
# Meta app (Facebook Pages + Instagram). Publishing permissions need App Review.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v27.0
# LinkedIn app with "Share on LinkedIn" + "Sign In with LinkedIn using OpenID Connect"
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202610
MARKETING_HTTP_TIMEOUT=20
