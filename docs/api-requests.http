### GrowthCognix API smoke collection (VS Code REST Client / JetBrains HTTP client)
@base = http://localhost:8000

### Register an agency (returns access_token)
POST {{base}}/api/v1/auth/register
Content-Type: application/json

{"agency_name": "Demo Agency", "full_name": "Your Name", "email": "you@youragency.com", "password": "ChangeMe123"}

### Login
# @name login
POST {{base}}/api/v1/auth/login
Content-Type: application/json

{"email": "you@youragency.com", "password": "ChangeMe123"}

###
@token = {{login.response.body.access_token}}

### Create a client
# @name client
POST {{base}}/api/v1/clients
Authorization: Bearer {{token}}
Content-Type: application/json

{"company_name": "Example Industries", "website": "example.com", "industry": "Manufacturing", "target_markets": ["Karnataka"], "marketing_budget": 50000, "budget_currency": "INR"}

### List clients
GET {{base}}/api/v1/clients?q=example
Authorization: Bearer {{token}}

### Add a product
POST {{base}}/api/v1/products
Authorization: Bearer {{token}}
Content-Type: application/json

{"client_id": "{{client.response.body.id}}", "name": "Product name", "kind": "product", "target_industries": ["Food processing"]}

### Upload a document
POST {{base}}/api/v1/documents
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=B

--B
Content-Disposition: form-data; name="client_id"

{{client.response.body.id}}
--B
Content-Disposition: form-data; name="file"; filename="catalogue.pdf"
Content-Type: application/pdf

< ./catalogue.pdf
--B--

### Dashboard counts (live counts only)
GET {{base}}/api/v1/dashboard/summary
Authorization: Bearer {{token}}

### Activity log
GET {{base}}/api/v1/activity
Authorization: Bearer {{token}}

### ---------------- Phase 2: Client Intelligence
### AI provider status
GET {{base}}/api/v1/intelligence/providers
Authorization: Bearer {{token}}

### Start an analysis (all stages)
POST {{base}}/api/v1/clients/{{client_id}}/intelligence/analyses
Authorization: Bearer {{token}}
Content-Type: application/json

{}

### List analyses for a client
GET {{base}}/api/v1/clients/{{client_id}}/intelligence/analyses
Authorization: Bearer {{token}}

### Retry failed stages
POST {{base}}/api/v1/intelligence/analyses/{{analysis_id}}/retry
Authorization: Bearer {{token}}

### Intelligence summary
GET {{base}}/api/v1/clients/{{client_id}}/intelligence
Authorization: Bearer {{token}}

### Markdown report
GET {{base}}/api/v1/clients/{{client_id}}/intelligence/report.md
Authorization: Bearer {{token}}

### List findings (profile | application | market | persona | insight)
GET {{base}}/api/v1/clients/{{client_id}}/intelligence/findings/persona
Authorization: Bearer {{token}}

### Add a finding by hand
POST {{base}}/api/v1/clients/{{client_id}}/intelligence/findings/market
Authorization: Bearer {{token}}
Content-Type: application/json

{"data": {"scope": "country", "name": "Germany", "priority": "medium"}, "note": "Client call, 16 Nov"}

### Approve a finding (manager+)
POST {{base}}/api/v1/intelligence/findings/market/{{finding_id}}/review
Authorization: Bearer {{token}}
Content-Type: application/json

{"action": "approve"}

### Extract a document's text
POST {{base}}/api/v1/documents/{{document_id}}/extract
Authorization: Bearer {{token}}

### ---------------- Phase 3: Website audit & competitors
### Crawler status
GET {{base}}/api/v1/crawler/status
Authorization: Bearer {{token}}

### Save crawl settings for the client's site
PUT {{base}}/api/v1/clients/{{client_id}}/website
Authorization: Bearer {{token}}
Content-Type: application/json

{"crawl_config": {"max_pages": 50, "max_depth": 3, "delay_seconds": 1, "exclude": ["/blog/*"]}, "crawl_interval_days": 30}

### Start a website audit (crawl + technical audit + SEO + PageSpeed if configured)
POST {{base}}/api/v1/clients/{{client_id}}/website-audits
Authorization: Bearer {{token}}
Content-Type: application/json

{}

### Crawl status / pages / retry
GET {{base}}/api/v1/crawls/{{crawl_id}}
Authorization: Bearer {{token}}

###
GET {{base}}/api/v1/crawls/{{crawl_id}}/pages?status=failed
Authorization: Bearer {{token}}

###
POST {{base}}/api/v1/crawls/{{crawl_id}}/retry
Authorization: Bearer {{token}}

### Audit findings and report
GET {{base}}/api/v1/website-audits/{{audit_id}}/findings?severity=high
Authorization: Bearer {{token}}

###
GET {{base}}/api/v1/website-audits/{{audit_id}}/report.md
Authorization: Bearer {{token}}

### Add a competitor
POST {{base}}/api/v1/clients/{{client_id}}/competitors
Authorization: Bearer {{token}}
Content-Type: application/json

{"name": "Rival Pumps", "website": "rival.example.com", "category": "direct", "relevance": {"product": "solar pumps", "geography": "Gujarat"}, "monitor_interval_days": 7}

### AI competitor suggestions (needs GROQ_API_KEY or GEMINI_API_KEY)
POST {{base}}/api/v1/clients/{{client_id}}/competitors/suggest
Authorization: Bearer {{token}}

### Analyse a competitor (crawl + snapshot + change detection)
POST {{base}}/api/v1/competitors/{{competitor_id}}/analyse
Authorization: Bearer {{token}}
Content-Type: application/json

{}

### Comparison and changes
GET {{base}}/api/v1/clients/{{client_id}}/competitors/comparison
Authorization: Bearer {{token}}

###
GET {{base}}/api/v1/clients/{{client_id}}/competitor-changes
Authorization: Bearer {{token}}

### Opportunities
POST {{base}}/api/v1/clients/{{client_id}}/opportunities/analyse
Authorization: Bearer {{token}}

###
POST {{base}}/api/v1/opportunities/{{opportunity_id}}/review
Authorization: Bearer {{token}}
Content-Type: application/json

{"action": "approve"}


### ---------------- Phase 4: buyer discovery & lead intelligence
GET {{base}}/api/v1/leads/providers
Authorization: Bearer {{token}}

### Save a research area (country, then state/district/city/industrial_area with parent_id)
POST {{base}}/api/v1/clients/{{client_id}}/leads/geographies
Authorization: Bearer {{token}}
Content-Type: application/json

{"level": "country", "name": "India"}

### Generate buyer-profile hypotheses (needs GEMINI_API_KEY or GROQ_API_KEY)
POST {{base}}/api/v1/clients/{{client_id}}/leads/buyer-profiles/generate
Authorization: Bearer {{token}}
Content-Type: application/json

{"buyer_types": ["end_user", "distributor"]}

### Create a campaign (approved profiles only)
POST {{base}}/api/v1/clients/{{client_id}}/leads/campaigns
Authorization: Bearer {{token}}
Content-Type: application/json

{"name": "Belagavi dairies", "persona_ids": ["{{persona_id}}"], "geography_ids": ["{{geo_id}}"], "sources": ["searxng"]}

### Start / resume, pause, cancel
POST {{base}}/api/v1/leads/campaigns/{{campaign_id}}/start
Authorization: Bearer {{token}}

### Prospects with filters
GET {{base}}/api/v1/clients/{{client_id}}/leads/prospects?district=Belagavi&min_score=40&sort=score
Authorization: Bearer {{token}}

### Verify a field (note or source URL required)
POST {{base}}/api/v1/leads/prospects/{{prospect_id}}/verify
Authorization: Bearer {{token}}
Content-Type: application/json

{"field": "company", "decision": "verified", "note": "CIN checked", "source_url": "https://www.mca.gov.in/"}

### Approve, export, hand off
POST {{base}}/api/v1/clients/{{client_id}}/leads/approve
Authorization: Bearer {{token}}
Content-Type: application/json

{"prospect_ids": ["{{prospect_id}}"], "approved": true}

###
GET {{base}}/api/v1/clients/{{client_id}}/leads/export?format=xlsx
Authorization: Bearer {{token}}

### UN Comtrade (historical trade, public preview)
POST {{base}}/api/v1/clients/{{client_id}}/leads/market-insights/comtrade
Authorization: Bearer {{token}}
Content-Type: application/json

{"hs_code": "8413", "reporter": "India", "period": "2023", "flow": "M"}
