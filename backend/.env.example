DATABASE_URL=postgresql+psycopg://growth:growth@db:5432/growthcognix
REDIS_URL=redis://redis:6379/0
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=480
CORS_ORIGINS=http://localhost:3000
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=20

# ---- Phase 2: AI providers (free tiers). Keys stay on the server, never in the frontend. ----
# Gemini key: https://aistudio.google.com/apikey   Groq key: https://console.groq.com/keys
AI_ANALYSIS_PROVIDER=gemini
AI_FAST_PROVIDER=groq
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_TIMEOUT_SECONDS=90
ANALYSIS_INLINE=false
WEBSITE_MAX_PAGES=5

# ---- Phase 3: website audit & competitor intelligence ----
# native = built-in robots.txt-aware crawler (free). firecrawl = self-hosted Firecrawl (free, AGPL) or Firecrawl cloud (paid beyond its free credits)
CRAWLER_PROVIDER=native
FIRECRAWL_API_URL=
FIRECRAWL_API_KEY=
CRAWL_MAX_PAGES_LIMIT=500
CRAWL_DEFAULT_MAX_PAGES=50
CRAWL_DEFAULT_MAX_DEPTH=3
CRAWL_DEFAULT_DELAY_SECONDS=1.0
CRAWL_TIMEOUT_SECONDS=20
CRAWL_MAX_BYTES=3000000
COMPETITOR_MAX_PAGES=25
# Google PageSpeed Insights API key (free, from Google Cloud console). Empty = performance not measured.
PAGESPEED_API_KEY=
